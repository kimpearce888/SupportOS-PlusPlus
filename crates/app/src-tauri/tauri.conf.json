{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupportOS++",
  "version": "0.1.0",
  "identifier": "com.supportos.plusplus",
  "build": {
    "beforeDevCommand": "cargo run -p supportos-plusplus-xtask --bin xtask -- trunk-serve",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SupportOS++",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "kimpearce888",
    "category": "Productivity",
    "shortDescription": "Local-first AI-powered support operating system for Help Scout",
    "longDescription": "SupportOS++ is an independent, open-source Rust/Tauri desktop reimplementation of supportos. Local-first: no telemetry, no cloud AI, no data egress.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"]
      }
    }
  }
}
